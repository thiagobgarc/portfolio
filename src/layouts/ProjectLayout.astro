---
import BaseLayout from './BaseLayout.astro';
import Tag from '@/components/ui/Tag.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { cx, statusLabel, type ProjectStatus } from '@/lib/utils';

interface Props {
  title: string;
  summary: string;
  status: ProjectStatus;
  role: string;
  stack: string[];
  repoUrl: string;
  liveUrl?: string | undefined;
  ogImage: string;
}

const { title, summary, status, role, stack, repoUrl, liveUrl, ogImage } = Astro.props;

const statusStyles: Record<Props['status'], string> = {
  complete: 'bg-accent/15 text-accent',
  'in-progress': 'bg-accent/15 text-accent',
  'early-stage': 'bg-canvas-subtle text-ink-muted',
  archived: 'bg-canvas-subtle text-ink-muted',
};
---

<BaseLayout title={title} description={summary} ogImage={ogImage}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/projects" class="hover-link text-sm text-ink-muted transition-colors hover:text-ink"
      >&larr; All projects</a
    >

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-4xl leading-[1.1] font-semibold tracking-[-0.02em] text-ink sm:text-5xl">{title}</h1>
        <span
          class:list={[
            'rounded-[2px] px-2 py-0.5 text-[0.8125rem]',
            statusStyles[status],
          ]}
        >
          {statusLabel[status]}
        </span>
      </div>
      <p class="mt-4 text-lg text-ink-muted">{summary}</p>
      <p class="mt-2 text-sm text-ink-muted">Role: {role}</p>

      <div class="mt-4 flex flex-wrap gap-2">
        {stack.map((item) => <Tag>{item}</Tag>)}
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <ExternalLink
          href={repoUrl}
          class="inline-flex items-center gap-2 rounded-[3px] border border-border px-4 py-2 text-[0.9375rem] font-semibold text-ink transition-colors hover:border-ink-muted hover:bg-canvas-subtle"
        >
          View repository
        </ExternalLink>
        {
          liveUrl && (
            <ExternalLink
              href={liveUrl}
              class={cx(
                'inline-flex items-center gap-2 rounded-[3px] px-4 py-2 text-[0.9375rem] font-semibold',
                'bg-accent text-accent-ink hover:opacity-90',
              )}
            >
              View live
            </ExternalLink>
          )
        }
      </div>
    </header>

    <div
      class="prose prose-neutral prose-invert prose-li:text-ink-muted prose-code:before:content-none prose-code:after:content-none mt-12 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink prose-p:text-ink-muted prose-a:text-accent prose-a:underline-offset-4 prose-strong:text-ink prose-code:text-ink"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
