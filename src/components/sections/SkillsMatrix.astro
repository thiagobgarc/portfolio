---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SkillTag from '@/components/ui/SkillTag.astro';
import { skills } from '@/data/skills';
---

<section class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading
    title="Technical skills"
    description="Select a skill to see which projects use it."
  />

  <dl class="mt-10 max-w-3xl border-b border-border">
    {
      skills.map((group) => (
        <div class="grid gap-x-8 gap-y-2 border-t border-border py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="font-medium text-ink">{group.category}</dt>
          <dd class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <SkillTag name={item.name} projects={item.projects} />
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<script is:inline>
  (function () {
    function clampPopover(wrap) {
      const popover = wrap.querySelector('.skill-popover');
      if (!popover) return;

      popover.style.transform = '';
      const rect = popover.getBoundingClientRect();
      const margin = 8;
      let shift = 0;

      if (rect.left < margin) {
        shift = margin - rect.left;
      } else if (rect.right > window.innerWidth - margin) {
        shift = window.innerWidth - margin - rect.right;
      }

      if (shift !== 0) {
        popover.style.transform = `translateX(calc(-50% + ${shift}px))`;
      }
    }

    const wraps = document.querySelectorAll('.skill-tag-wrap');

    function setOpen(wrap, open) {
      const button = wrap.querySelector('.skill-tag-button');
      if (!button) return;
      wrap.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
      if (open) clampPopover(wrap);
    }

    function closeAll(except) {
      wraps.forEach((wrap) => {
        if (wrap !== except) setOpen(wrap, false);
      });
    }

    wraps.forEach((wrap) => {
      wrap.addEventListener('mouseenter', () => clampPopover(wrap));
      wrap.addEventListener('focusin', () => clampPopover(wrap));

      const button = wrap.querySelector('.skill-tag-button');
      if (!button) return;
      // Tap/click/Enter/Space toggles, so the project list is reachable
      // without a mouse — hover alone never fires on touch screens.
      button.addEventListener('click', () => {
        const open = !wrap.classList.contains('is-open');
        closeAll(wrap);
        setOpen(wrap, open);
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('.skill-tag-wrap')) {
        closeAll(null);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = document.querySelector('.skill-tag-wrap.is-open');
      if (!open) return;
      setOpen(open, false);
      open.querySelector('.skill-tag-button')?.focus();
    });
  })();
</script>
