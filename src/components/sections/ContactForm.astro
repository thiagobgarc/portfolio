---
import { profile } from '@/data/profile';
---

{
  profile.email ? (
    <form id="contact-form" data-target-email={profile.email} class="space-y-5" novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="contact-name" class="text-sm font-medium text-ink">
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            aria-describedby="contact-name-error"
            class="mt-1.5 w-full rounded-md border border-border bg-canvas px-3 py-2 text-sm text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
          <p id="contact-name-error" class="mt-1 min-h-4 text-xs text-danger" role="alert" />
        </div>
        <div>
          <label for="contact-email" class="text-sm font-medium text-ink">
            Your email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="contact-email-error"
            class="mt-1.5 w-full rounded-md border border-border bg-canvas px-3 py-2 text-sm text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
          <p id="contact-email-error" class="mt-1 min-h-4 text-xs text-danger" role="alert" />
        </div>
      </div>

      <div>
        <label for="contact-message" class="text-sm font-medium text-ink">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          aria-describedby="contact-message-error"
          class="mt-1.5 w-full rounded-md border border-border bg-canvas px-3 py-2 text-sm text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        />
        <p id="contact-message-error" class="mt-1 min-h-4 text-xs text-danger" role="alert" />
      </div>

      {/* Honeypot: invisible to sighted/keyboard users, bots fill every field they can find. */}
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="contact-company">Company</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          id="contact-submit"
          class="btn-lift inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-[transform,box-shadow,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:scale-[1.03] active:translate-y-0 active:scale-100 disabled:pointer-events-none disabled:opacity-60"
        >
          Send message
        </button>
        <p id="contact-status" class="text-sm text-ink-muted" role="status" aria-live="polite" />
      </div>
    </form>
  ) : (
    <p class="text-ink-muted">
      Contact form pending &mdash; add a real address in{' '}
      <code class="font-mono text-sm">src/data/profile.ts</code> to enable this section.
    </p>
  )
}

<style>
  .btn-lift:hover {
    box-shadow: 8px 10px 16px -8px color-mix(in oklch, var(--accent) 22%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-lift:hover {
      transform: none;
    }
  }
</style>

<script>
  import { validateContactForm } from '@/features/contact/validation';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const targetEmail = form.dataset.targetEmail ?? '';
    const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const status = document.getElementById('contact-status');
    const errorFields = ['name', 'email', 'message'] as const;
    const errorEls: Partial<Record<(typeof errorFields)[number], HTMLElement | null>> = {
      name: document.getElementById('contact-name-error'),
      email: document.getElementById('contact-email-error'),
      message: document.getElementById('contact-message-error'),
    };

    const clearErrors = () => {
      for (const field of errorFields) {
        const el = errorEls[field];
        if (el) el.textContent = '';
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors();
      if (status) status.textContent = '';

      const payload = Object.fromEntries(new FormData(form).entries());
      const { success, errors } = validateContactForm(payload);

      if (!success) {
        for (const field of errorFields) {
          const el = errorEls[field];
          const message = errors[field];
          if (el && message) el.textContent = message;
        }
        if (status) status.textContent = 'Please fix the errors above.';
        return;
      }

      if (submitButton) submitButton.disabled = true;
      if (status) status.textContent = 'Sending…';

      fetch(`https://formsubmit.co/ajax/${encodeURIComponent(targetEmail)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name: payload.name,
          email: payload.email,
          message: payload.message,
          _subject: `Portfolio contact from ${String(payload.name)}`,
          _captcha: 'false',
          _template: 'table',
        }),
      })
        .then((response) => {
          if (!response.ok) throw new Error('Request failed');
          form.reset();
          if (status) status.textContent = "Thanks — your message is on its way. I'll reply by email.";
        })
        .catch(() => {
          if (status) {
            status.textContent = `Something went wrong sending that. Please email me directly at ${targetEmail} instead.`;
          }
        })
        .finally(() => {
          if (submitButton) submitButton.disabled = false;
        });
    });
  }
</script>
