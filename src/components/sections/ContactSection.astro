---
import Button from '@/components/ui/Button.astro';
import { profile } from '@/data/profile';
---

<section class="border-t border-border bg-canvas-subtle">
  <div
    class="mx-auto flex max-w-content flex-col gap-6 px-4 py-14 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div>
      <h2 class="text-[1.75rem] leading-[1.1] font-semibold tracking-[-0.02em] text-ink sm:text-4xl">
        Contact me
      </h2>
      <p class="mt-2 text-ink-muted">The form goes straight to my inbox.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href="/contact">Send a message</Button>
      <Button href={profile.resumeUrl} variant="secondary" external>Download résumé</Button>
    </div>
  </div>
</section>
