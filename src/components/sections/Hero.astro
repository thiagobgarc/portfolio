---
import Button from '@/components/ui/Button.astro';
import HeroDiamond from '@/components/ui/HeroDiamond.astro';
import MythosMap from '@/components/ui/MythosMap.astro';
import { profile } from '@/data/profile';
---

<section>
  <!-- Mobile: the gem sits small beside the name. Desktop: it gets its own
       column beside the headline, spanning all four rows. -->
  <div
    class="mx-auto grid max-w-content grid-cols-[minmax(0,1fr)_6.5rem] gap-x-4 px-4 pt-10 pb-12 sm:grid-cols-[minmax(0,1fr)_9rem] sm:px-6 sm:pt-16 sm:pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,21rem)] lg:gap-x-12"
  >
    <h1 class="col-start-1 row-start-1 self-center text-lg leading-snug font-semibold text-ink">
      {profile.name}<span class="sr-only">, {profile.role}</span>
    </h1>
    <div class="col-start-2 row-start-1 lg:row-span-4 lg:self-center">
      <HeroDiamond />
    </div>
    <p
      class="col-span-2 row-start-2 mt-5 max-w-[20ch] text-[clamp(2.125rem,5vw,3.75rem)] leading-[1.05] font-semibold tracking-[-0.03em] text-ink lg:col-span-1"
    >
      {profile.headline}
    </p>
    <p class="col-span-2 row-start-3 mt-6 max-w-[52ch] text-lg leading-relaxed text-ink-muted lg:col-span-1">
      {profile.currentFocus}
    </p>
    <div class="col-span-2 row-start-4 mt-8 flex flex-wrap items-center gap-3 lg:col-span-1">
      <Button href="/projects/mythos-wow-bis">Read the Mythos case study</Button>
      <Button href="https://mythosbis.com" variant="secondary" external>Visit mythosbis.com</Button>
      <Button href={profile.resumeUrl} variant="secondary" external>Résumé (PDF)</Button>
      <a href="/projects" class="hover-link text-[0.9375rem] sm:ml-2 font-medium text-ink">All projects</a>
    </div>
  </div>

  <div class="blueprint-grid border-y border-border">
    <div class="mx-auto max-w-[56rem] px-4 py-10 sm:px-6 sm:py-14">
      <MythosMap animate />
      <p class="mt-8 text-[0.9375rem] text-ink-muted">
        Complete and live at
        <a href="https://mythosbis.com" class="hover-link font-medium text-ink" target="_blank" rel="noopener noreferrer">mythosbis.com</a>.
        Every push to <code>main</code> deploys to production on Vercel.
      </p>
    </div>
  </div>
</section>
