---
import Button from '@/components/ui/Button.astro';
import { profile } from '@/data/profile';
---

<section class="relative overflow-hidden">
  <svg
    id="hero-flow"
    class="flow-ribbon pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1200 500"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Horizontal, viewBox-anchored (not corner-anchored): fades in over
           the first 15% of the width and out over the last 15%, entirely
           inside the visible 0-1200 area. Because the fade tracks x position
           rather than a fixed diagonal, the wave always dims to nothing
           before it reaches the edge, however it happens to be undulating
           vertically at that moment — no more hard cutoff at the frame. -->
      <linearGradient id="flow-gradient-back" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1200" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0" />
        <stop offset="15%" stop-color="var(--accent)" stop-opacity="0.55" />
        <stop offset="85%" stop-color="var(--accent)" stop-opacity="0.55" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="flow-gradient-front" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1200" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0" />
        <stop offset="15%" stop-color="var(--accent)" stop-opacity="0.9" />
        <stop offset="50%" stop-color="color-mix(in oklch, var(--accent) 55%, white)" stop-opacity="1" />
        <stop offset="85%" stop-color="var(--accent)" stop-opacity="0.9" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
      <filter id="flow-blur-back" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
      <filter id="flow-blur-front" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="8" />
      </filter>
      <filter id="diamond-blur" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur stdDeviation="3" />
      </filter>
    </defs>
    <g>
      <path class="flow-wave flow-wave-back-glow" data-layer="back" fill="none" stroke="url(#flow-gradient-back)" stroke-width="46" stroke-linecap="round" filter="url(#flow-blur-back)" />
      <path class="flow-wave flow-wave-back" data-layer="back" fill="none" stroke="url(#flow-gradient-back)" stroke-width="18" stroke-linecap="round" />
      <path class="flow-wave flow-wave-front-glow" data-layer="front" fill="none" stroke="url(#flow-gradient-front)" stroke-width="20" stroke-linecap="round" filter="url(#flow-blur-front)" />
      <path class="flow-wave flow-wave-front" data-layer="front" fill="none" stroke="url(#flow-gradient-front)" stroke-width="3.5" stroke-linecap="round" />
    </g>
    <g class="hero-diamond">
      <path
        class="diamond-facets diamond-facets-glow"
        fill="none"
        stroke="var(--accent)"
        stroke-width="3.5"
        stroke-linecap="round"
        filter="url(#diamond-blur)"
        d="M935 140 L1025 140 M1025 140 L1075 175 M1075 175 L1100 220 M1100 220 L1035 300 M1035 300 L980 410 M980 410 L925 300 M925 300 L860 220 M860 220 L885 175 M885 175 L935 140 M935 140 L1100 220 M1025 140 L860 220 M1100 220 L925 300 M860 220 L1035 300 M935 140 L980 410 M1025 140 L980 410"
      />
      <path
        class="diamond-facets"
        fill="none"
        stroke="color-mix(in oklch, var(--accent) 65%, transparent)"
        stroke-width="1.25"
        stroke-linecap="round"
        d="M935 140 L1025 140 M1025 140 L1075 175 M1075 175 L1100 220 M1100 220 L1035 300 M1035 300 L980 410 M980 410 L925 300 M925 300 L860 220 M860 220 L885 175 M885 175 L935 140 M935 140 L1100 220 M1025 140 L860 220 M1100 220 L925 300 M860 220 L1035 300 M935 140 L980 410 M1025 140 L980 410"
      />
      {[
        [935, 140, 3],
        [1025, 140, 3],
        [1075, 175, 3],
        [1100, 220, 4.5],
        [1035, 300, 3],
        [980, 410, 4.5],
        [925, 300, 3],
        [860, 220, 4.5],
        [885, 175, 3],
      ].map(([cx, cy, r], i) => (
        <circle
          class="diamond-node"
          cx={cx}
          cy={cy}
          r={r}
          fill="var(--accent)"
          style={`animation-delay: ${(i * 0.35).toFixed(2)}s`}
        />
      ))}
      {[
        [770, 120, 1.8],
        [1150, 90, 2.2],
        [1120, 380, 1.5],
        [800, 400, 2],
        [1180, 250, 1.3],
        [760, 300, 1.6],
        [1010, 60, 1.4],
      ].map(([cx, cy, r], i) => (
        <circle
          class="diamond-star"
          cx={cx}
          cy={cy}
          r={r}
          fill="var(--accent)"
          style={`animation-delay: ${(i * 0.5).toFixed(2)}s`}
        />
      ))}
    </g>
  </svg>
  <div class="relative mx-auto max-w-content px-4 py-20 sm:px-6 sm:py-28">
    <p class="font-mono text-lg font-semibold uppercase tracking-wide text-accent sm:text-xl">
      {profile.role}
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      {profile.name}
    </h1>
    <p class="mt-3 max-w-2xl text-base italic text-ink-muted sm:text-lg">
      &ldquo;{profile.bioQuote}&rdquo;
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/projects">View projects</Button>
      <Button href={profile.resumeUrl} variant="secondary" external>Resume</Button>
      <Button href="/contact" variant="secondary">Contact</Button>
    </div>
  </div>
</section>

<style>
  .flow-ribbon {
    z-index: 0;
  }

  /* Right-side accent glyph — hidden below the point where the text column
     no longer has clear space to its right, so it never overlaps copy. */
  .hero-diamond {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-diamond {
      display: block;
    }
  }

  .diamond-facets-glow {
    opacity: 0.6;
  }

  .diamond-node,
  .diamond-star {
    animation: diamond-twinkle 3s ease-in-out infinite;
  }

  .diamond-star {
    animation-duration: 2.4s;
  }

  @keyframes diamond-twinkle {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  (function () {
    // Two glowing bands whose *shape* undulates like a travelling sine wave —
    // not just a static curve with a highlight sliding along it — closer to
    // the PS4 startup "flow" look. Each frame resamples the curve at a few
    // points and threads a smooth quadratic path through them, then nudges
    // the phase forward so the wave appears to flow sideways.
    const svg = document.getElementById('hero-flow');
    if (!svg) return;

    const WIDTH = 1200;
    const POINTS = 18;

    const layers = [
      {
        selector: '[data-layer="back"]',
        amplitude: 55,
        wavelength: 620,
        yBase: 330,
        speed: 0.35,
        phase: 0,
      },
      {
        selector: '[data-layer="front"]',
        amplitude: 34,
        wavelength: 420,
        yBase: 250,
        speed: -0.55,
        phase: 2,
      },
    ];

    layers.forEach((layer) => {
      layer.els = svg.querySelectorAll(layer.selector);
    });

    function wavePath(amplitude, wavelength, phase, yBase) {
      const step = (WIDTH + 200) / (POINTS - 1);
      const pts = [];
      for (let i = 0; i < POINTS; i++) {
        const x = -100 + i * step;
        const y = yBase + amplitude * Math.sin((2 * Math.PI * x) / wavelength + phase);
        pts.push([x, y]);
      }
      let d = `M ${pts[0][0]} ${pts[0][1]}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const [cx, cy] = pts[i];
        const [nx, ny] = pts[i + 1];
        d += ` Q ${cx} ${cy} ${(cx + nx) / 2} ${(cy + ny) / 2}`;
      }
      const last = pts[pts.length - 1];
      d += ` L ${last[0]} ${last[1]}`;
      return d;
    }

    function render() {
      layers.forEach((layer) => {
        const d = wavePath(layer.amplitude, layer.wavelength, layer.phase, layer.yBase);
        layer.els.forEach((el) => el.setAttribute('d', d));
      });
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    render();
    if (reduceMotion) return;

    let last = performance.now();
    function tick(now) {
      const dt = (now - last) / 1000;
      last = now;
      layers.forEach((layer) => {
        layer.phase += layer.speed * dt;
      });
      render();
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>
