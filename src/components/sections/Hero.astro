---
import Button from '@/components/ui/Button.astro';
import { profile } from '@/data/profile';
---

<section class="relative overflow-hidden">
  <div class="gradient-flow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-content px-4 py-20 sm:px-6 sm:py-28">
    <p class="font-mono text-lg font-semibold uppercase tracking-wide text-accent sm:text-xl">
      {profile.role}
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      {profile.name}
    </h1>
    <p class="mt-3 max-w-2xl text-base italic text-ink-muted sm:text-lg">
      &ldquo;{profile.bioQuote}&rdquo;
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/projects">View projects</Button>
      <Button href={profile.resumeUrl} variant="secondary">Resume</Button>
      <Button href="/contact" variant="secondary">Contact</Button>
    </div>
  </div>
</section>

<style>
  /* Soft, slowly drifting blobs of the site's accent color behind the hero
     copy — evokes the PS3/4/5 "flow" backgrounds without a canvas/WebGL
     dependency. Masked to fade at the edges so it reads as a glow, not a
     hard-edged panel; prefers-reduced-motion is handled globally in
     global.css (it clamps all animation-duration to ~0). */
  .gradient-flow {
    z-index: 0;
    filter: blur(70px) saturate(130%);
    opacity: 0.5;
    background-repeat: no-repeat;
    background-image:
      radial-gradient(closest-side, var(--accent) 0%, transparent 100%),
      radial-gradient(
        closest-side,
        color-mix(in oklch, var(--accent) 70%, var(--canvas-subtle)) 0%,
        transparent 100%
      ),
      radial-gradient(
        closest-side,
        color-mix(in oklch, var(--accent) 45%, transparent) 0%,
        transparent 100%
      );
    background-size:
      45% 60%,
      35% 45%,
      40% 50%;
    background-position:
      10% 20%,
      85% 15%,
      55% 85%;
    -webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 78%);
    mask-image: radial-gradient(ellipse at center, black 45%, transparent 78%);
    animation: gradient-flow 24s ease-in-out infinite alternate;
  }

  @keyframes gradient-flow {
    0% {
      background-position:
        10% 20%,
        85% 15%,
        55% 85%;
    }
    50% {
      background-position:
        60% 65%,
        20% 75%,
        85% 25%;
    }
    100% {
      background-position:
        30% 80%,
        70% 25%,
        20% 55%;
    }
  }
</style>
