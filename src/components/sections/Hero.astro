---
import Button from '@/components/ui/Button.astro';
import MythosMap from '@/components/ui/MythosMap.astro';
import { profile } from '@/data/profile';
---

<section>
  <div class="mx-auto max-w-content px-4 pt-14 pb-12 sm:px-6 sm:pt-20 sm:pb-16">
    <h1 class="text-lg leading-snug">
      <span class="block font-semibold text-ink">{profile.name}</span>
      <span class="block text-ink-muted">{profile.role}</span>
    </h1>
    <p
      class="mt-6 max-w-[28ch] text-[clamp(1.875rem,4.4vw,3.25rem)] leading-[1.08] font-semibold tracking-[-0.025em] text-ink"
    >
      {profile.tagline}
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <Button href="/projects/mythos-wow-bis">Read the case study</Button>
      <Button href={profile.resumeUrl} variant="secondary" external>Résumé (PDF)</Button>
      <a href="/projects" class="hover-link text-[0.9375rem] sm:ml-2 font-medium text-ink">All projects</a>
    </div>
  </div>

  <div class="blueprint-grid border-y border-border">
    <div class="mx-auto max-w-[56rem] px-4 py-10 sm:px-6 sm:py-14">
      <MythosMap animate />
      <p class="mt-8 text-[0.9375rem] text-ink-muted">
        In progress. The Blizzard integration, comparison engine, and tests work end to end. Next:
        current-season Best-in-Slot data and a first production deploy.
      </p>
    </div>
  </div>
</section>
