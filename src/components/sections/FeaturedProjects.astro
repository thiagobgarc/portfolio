---
import { getCollection } from 'astro:content';
import { statusLabel } from '@/lib/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tag from '@/components/ui/Tag.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const falarEntries = projects.filter((p) => p.data.system === 'falar');
const standalone = projects.filter((p) => p.data.system !== 'falar');

type FeaturedRow = {
  href: string;
  title: string;
  summary: string;
  stack: string[];
  meta: string;
  order: number;
};

// The Falar repos collapse into one row that sits where its first repo
// would, so `order` in each case study's frontmatter controls the list.
const falarRow: FeaturedRow[] = falarEntries.length
  ? [
      {
        href: '/projects/falar-system',
        title: 'Falar: one product, three architectures',
        summary:
          'A Brazilian Portuguese learning product built as a desktop app, a mobile client, and a GraphQL backend — three repositories sharing one domain model.',
        stack: ['Electron', 'Flutter', 'GraphQL', 'PostgreSQL'],
        meta: `${falarEntries.length} repositories`,
        order: Math.min(...falarEntries.map((p) => p.data.order)),
      },
    ]
  : [];

const standaloneRows: FeaturedRow[] = standalone.map((p) => ({
  href: `/projects/${p.id}`,
  title: p.data.title,
  summary: p.data.summary,
  stack: p.data.stack,
  meta: statusLabel[p.data.status],
  order: p.data.order,
}));

const rows = [...falarRow, ...standaloneRows].sort((a, b) => a.order - b.order);
---

<section class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading
    title="Featured projects"
    description="Shipped, in progress, and honestly labeled either way."
  />

  <ul class="mt-10 border-b border-border">
    {
      rows.map((row) => (
        <li class="border-t border-border">
          <a
            href={row.href}
            class="group grid gap-x-10 gap-y-3 py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_9rem]"
          >
            <h3 class="text-xl leading-tight font-semibold tracking-[-0.01em] text-ink transition-colors group-hover:text-accent">
              {row.title}
            </h3>
            <div>
              <p class="max-w-[60ch] text-ink-muted">{row.summary}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {row.stack.slice(0, 4).map((item) => (
                  <Tag>{item}</Tag>
                ))}
              </div>
            </div>
            <p class="text-[0.9375rem] text-ink-muted md:text-right">{row.meta}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <a href="/projects" class="hover-link mt-8 inline-block font-medium text-ink">See all projects</a>
</section>
