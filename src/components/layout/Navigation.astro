---
import { primaryNav, writingEnabled } from '@/data/navigation';

const items = writingEnabled ? [...primaryNav, { label: 'Writing', href: '/writing' }] : primaryNav;
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<nav aria-label="Primary" class="hidden items-center gap-1 sm:flex">
  {
    items.map((item) => (
      <a
        href={item.href}
        class:list={[
          'hover-link px-3 py-2 text-[0.9375rem] font-medium transition-colors',
          isActive(item.href)
            ? 'text-ink decoration-accent!'
            : 'text-ink-muted hover:text-ink',
        ]}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>
