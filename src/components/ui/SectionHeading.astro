---
interface Props {
  title: string;
  description?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const { title, description, as: Tag = 'h2' }: Props = Astro.props;
const size = Tag === 'h1' ? 'text-4xl sm:text-5xl' : 'text-[1.75rem] sm:text-4xl';
---

<div class="max-w-2xl">
  <Tag class:list={['font-semibold leading-[1.1] tracking-[-0.02em] text-ink', size]}>{title}</Tag>
  {description && <p class="mt-3 text-ink-muted">{description}</p>}
</div>
