---
import type { RelatedProject } from '@/data/skills';

interface Props {
  name: string;
  projects?: RelatedProject[] | undefined;
}

const { name, projects = [] } = Astro.props;
const hasProjects = projects.length > 0;
---

<span class="skill-tag-wrap relative inline-block">
  <span
    class="skill-tag inline-flex items-center rounded-[2px] bg-canvas-subtle px-2 py-0.5 text-[0.8125rem] text-ink-muted"
  >
    {name}
  </span>
  {
    hasProjects && (
      <div class="skill-popover pointer-events-none absolute left-1/2 top-full z-10 mt-2 w-56 rounded-[3px] border border-border bg-canvas p-3 text-left opacity-0 shadow-lg">
        <p class="text-xs text-ink-muted">Used in</p>
        <ul class="mt-1.5 space-y-1">
          {projects.map((project) => (
            <li>
              <a
                href={project.href}
                class="text-xs text-ink hover:text-accent"
                {...project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
              >
                {project.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</span>

<style>
  .skill-tag {
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .skill-popover {
    transform: translateX(-50%);
    transition: opacity 150ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-tag-wrap:hover .skill-tag {
      background-color: color-mix(in oklab, var(--accent) 22%, var(--canvas-subtle));
      color: var(--ink);
    }

    .skill-tag-wrap:hover .skill-popover {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .skill-tag-wrap:focus-within .skill-popover {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-tag,
    .skill-popover {
      transition: none;
    }
  }
</style>
