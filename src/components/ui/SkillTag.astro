---
import type { RelatedProject } from '@/data/skills';

interface Props {
  name: string;
  projects?: RelatedProject[] | undefined;
}

const { name, projects = [] } = Astro.props;
const hasProjects = projects.length > 0;
const popoverId = `skill-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const tagClass =
  'skill-tag inline-flex items-center rounded-[2px] bg-canvas-subtle px-2 py-0.5 text-[0.8125rem] text-ink-muted';
---

<span class="skill-tag-wrap relative inline-block">
  {
    hasProjects ? (
      // A real button so the project list opens on tap and Enter/Space too,
      // not only on mouse hover. The toggle script lives in SkillsMatrix.
      <button
        type="button"
        class:list={[tagClass, 'skill-tag-button']}
        aria-expanded="false"
        aria-controls={popoverId}
      >
        {name}
      </button>
    ) : (
      <span class={tagClass}>{name}</span>
    )
  }
  {
    hasProjects && (
      <div
        id={popoverId}
        class="skill-popover absolute left-1/2 top-full z-10 mt-2 w-60 rounded-[3px] border border-border-strong bg-canvas p-3 text-left shadow-lg"
      >
        <p class="text-[0.8125rem] text-ink-muted">Used in</p>
        <ul class="mt-1">
          {projects.map((project) => (
            <li>
              <a
                href={project.href}
                class="hover-link block py-1 text-sm text-ink"
                {...(project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {project.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</span>

<style>
  .skill-tag {
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  /* Grow the tap area to ~40px tall without changing the tag's size. */
  .skill-tag-button {
    position: relative;
  }

  .skill-tag-button::after {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }

  /* Closed popovers use visibility, not just opacity, so their links aren't
     invisible tab stops. Visibility flips after the fade-out finishes. */
  .skill-popover {
    transform: translateX(-50%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 150ms ease-out,
      visibility 0s linear 150ms;
  }

  .skill-tag-wrap.is-open .skill-popover,
  .skill-tag-wrap:focus-within .skill-popover:focus-within {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 150ms ease-out,
      visibility 0s;
  }

  .skill-tag-wrap.is-open .skill-tag,
  .skill-tag-button:focus-visible {
    background-color: color-mix(in oklab, var(--accent) 22%, var(--canvas-subtle));
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-tag-wrap:hover .skill-tag {
      background-color: color-mix(in oklab, var(--accent) 22%, var(--canvas-subtle));
      color: var(--ink);
    }

    .skill-tag-wrap:hover .skill-popover {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 150ms ease-out,
        visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-tag,
    .skill-popover {
      transition: none;
    }
  }
</style>
