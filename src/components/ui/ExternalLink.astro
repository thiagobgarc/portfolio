---
interface Props {
  href: string;
  class?: string;
  'aria-label'?: string;
}

const { href, class: className, 'aria-label': ariaLabel } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className} aria-label={ariaLabel}>
  <slot />
  <span class="sr-only"> (opens in a new tab)</span>
</a>
