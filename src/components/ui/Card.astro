---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...href ? { href } : {}}
  class:list={['group block rounded-[3px] border border-border bg-canvas-subtle/40 p-6', href && 'card-hover', className]}
>
  <slot />
</Tag>
