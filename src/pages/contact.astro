---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CopyEmail from '@/components/ui/CopyEmail.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Button from '@/components/ui/Button.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { profile, socialLinks } from '@/data/profile';
---

<BaseLayout title="Contact" description="Get in touch with Thiago Bueno Garcia.">
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Contact" title="Get in touch" as="h1" />

    <div class="mt-10 space-y-8">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Email</h2>
        <div class="mt-2">
          {
            profile.email ? (
              <CopyEmail email={profile.email} />
            ) : (
              <p class="text-ink-muted">
                Email pending &mdash; add a real address in{' '}
                <code class="font-mono text-sm">src/data/profile.ts</code> to enable this section.
              </p>
            )
          }
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">
          Send a message
        </h2>
        <div class="mt-3">
          <ContactForm />
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Elsewhere</h2>
        <ul class="mt-2 space-y-1">
          {
            socialLinks.map((link) => (
              <li>
                <ExternalLink href={link.url} class="hover-grow text-ink transition-colors hover:text-accent">
                  {link.label}
                </ExternalLink>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">Résumé</h2>
        <div class="mt-3">
          <Button href={profile.resumeUrl} external>Download résumé (PDF)</Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
