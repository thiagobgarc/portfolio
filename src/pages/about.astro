---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tag from '@/components/ui/Tag.astro';
import Button from '@/components/ui/Button.astro';
import { profile } from '@/data/profile';
import { skills } from '@/data/skills';
import { education, currentActivity } from '@/data/experience';
---

<BaseLayout title="About" description={profile.positioning}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <SectionHeading title={profile.name} as="h1" />

    <div class="prose prose-neutral prose-invert prose-li:text-ink-muted prose-code:before:content-none prose-code:after:content-none mt-8 max-w-none prose-p:text-ink-muted prose-strong:text-ink">
      <p>
        One day I decided to make a change and challenge myself to become a software engineer. I
        enrolled at General Assembly. The hours were long, and learning to code felt like learning
        a new language. I kept going because I wanted a better life for myself and for my family.
      </p>
      <p>
        What kept me going was building things. I enjoy taking an idea and turning it into
        something people can use. I also care about how the pieces fit together, so the code still
        makes sense when I come back to it months later.
      </p>
      <p>
        Mythos is the best example of that. I play World of Warcraft, and figuring out my next gear
        upgrade meant jumping between an armory page, a BiS list and a few loot tables. So I built
        a tool to do it for me. It is now live at{' '}
        <a href="https://mythosbis.com" class="hover-link font-medium text-ink no-underline" target="_blank" rel="noopener noreferrer">mythosbis.com</a>,
        and anyone can use it.
      </p>
      <p>
        Right now I am {profile.currentlyBuilding} and reading Clean Architecture by Robert C.
        Martin. I am always looking for the next thing to build and people to learn from. Outside
        of code, I enjoy {profile.interests.join(', ')}.
      </p>
      <blockquote>
        <p>&ldquo;{profile.bioQuote}&rdquo;</p>
      </blockquote>
    </div>

    <div class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Education</h2>
      <ul class="mt-4 space-y-4">
        {
          education.map((entry) => (
            <li>
              <p class="font-medium text-ink">
                {entry.program} &mdash; {entry.institution}
              </p>
              <p class="text-sm text-ink-muted">{entry.period}</p>
              <p class="mt-1 text-sm text-ink-muted">{entry.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Right now</h2>
      <ul class="mt-4 list-inside list-disc space-y-1 text-ink-muted">
        {currentActivity.map((entry) => <li>{entry.label}</li>)}
      </ul>
    </div>

    <div class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Stack</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {skills.flatMap((group) => group.items).map((item) => <Tag>{item.name}</Tag>)}
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href={profile.resumeUrl} external>Download résumé</Button>
      <Button href="/contact" variant="secondary">Get in touch</Button>
    </div>
  </div>
</BaseLayout>
